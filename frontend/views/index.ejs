<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Manufacturing Inspector Pro — AI-powered equipment health analysis using explainable machine learning.">
    <title>Inspector Pro | Equipment Health Analysis</title>
    <!-- Only local CSS from public folder — no external href links -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('partials/header') %>

    <main class="page-wrapper <%= prediction ? '' : 'center-form' %>">
        <div style="width:100%;">

            <% if (error) { %>
                <div class="error-alert">
                    <strong>Something went wrong:</strong> <%= error %>
                </div>
            <% } %>

            <% if (prediction) { %>
                <%- include('partials/result-card', { prediction: prediction }) %>
            <% } else { %>
                <div class="form-card">
                    <%- include('partials/inspector-form') %>
                </div>
            <% } %>

        </div>
    </main>

    <%- include('partials/footer') %>

</body>

</html>
