<div class="glowing-card-shell">
    <div class="card-body">
        <h1 class="page-heading">Machine Check-up</h1>
        <p class="page-description">
            Enter your equipment's current sensor readings below. Our AI will instantly analyse the machine's
            health and tell you exactly why it reached its conclusion.
        </p>

        <form action="/get-prediction" method="POST">
            <div class="sensor-grid">

                <div class="sensor-field full-row">
                    <label class="field-label" for="field-machine-id">Machine Identifier</label>
                    <select class="field-input" id="field-machine-id" name="Machine_ID" required style="cursor: pointer;">
                        <option value="CNC Lathe Machine (CNC-L-01)">CNC Lathe Machine (CNC-L-01)</option>
                        <option value="5-Axis Milling Machine (MIL-5X-02)">5-Axis Milling Machine (MIL-5X-02)</option>
                        <option value="Hydraulic Press (PRS-HYD-03)">Hydraulic Press (PRS-HYD-03)</option>
                        <option value="Industrial Robot Arm (ROB-ARM-04)">Industrial Robot Arm (ROB-ARM-04)</option>
                        <option value="Injection Molding Unit (INJ-MLD-05)">Injection Molding Unit (INJ-MLD-05)</option>
                        <option value="Automated Conveyor System (CON-SYS-06)">Automated Conveyor System (CON-SYS-06)</option>
                        <option value="Laser Cutting Machine (LSR-CUT-07)">Laser Cutting Machine (LSR-CUT-07)</option>
                        <option value="Centrifugal Pump (PMP-CEN-08)">Centrifugal Pump (PMP-CEN-08)</option>
                    </select>
                </div>

                <div class="sensor-field">
                    <label class="field-label" for="field-temperature">System Temperature (°C)</label>
                    <input class="field-input" type="number" id="field-temperature"
                           name="Temperature" step="0.1" value="70" required>
                </div>

                <div class="sensor-field">
                    <label class="field-label" for="field-pressure">Internal Pressure (PSI)</label>
                    <input class="field-input" type="number" id="field-pressure"
                           name="Pressure" step="0.1" value="50" required>
                </div>

                <div class="sensor-field">
                    <label class="field-label" for="field-speed">Operation Speed (RPM)</label>
                    <input class="field-input" type="number" id="field-speed"
                           name="Speed" step="1" value="1500" required>
                </div>

                <div class="sensor-field">
                    <label class="field-label" for="field-vibration">Vibration Level (mm/s)</label>
                    <input class="field-input" type="number" id="field-vibration"
                           name="Vibration" step="0.1" value="5" required>
                </div>

                <div class="sensor-field">
                    <label class="field-label" for="field-humidity">Ambient Humidity (%)</label>
                    <input class="field-input" type="number" id="field-humidity"
                           name="Humidity" step="0.1" value="50" required>
                </div>

                <div class="sensor-field">
                    <label class="field-label" for="field-power">Power Usage (kW)</label>
                    <input class="field-input" type="number" id="field-power"
                           name="Power_Consumption" step="0.1" value="15" required>
                </div>

                <div class="sensor-field full-row">
                    <label class="field-label" for="field-hardness">Work Material Hardness</label>
                    <input class="field-input" type="number" id="field-hardness"
                           name="Material_Hardness" step="0.1" value="60" required>
                </div>

            </div>

            <button class="submit-button" type="submit" id="run-analysis-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="3"
                     stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="5 3 19 12 5 21 5 3"/>
                </svg>
                <span>Run Health Analysis</span>
            </button>
        </form>
    </div>
</div>