<div class="card-wrapper">
    <div class="card-content">
        <h1>Machine Check-up</h1>
        <p class="subtitle">Enter the current machine readings below. Our system will analyze the health of your
            equipment in real-time.</p>

        <form action="/get-prediction" method="POST">
            <div class="form-grid">
                <div class="form-group">
                    <label>System Temperature (°C)</label>
                    <input type="number" name="Temperature" step="0.1" value="70" required>
                </div>
                <div class="form-group">
                    <label>Internal Pressure (PSI)</label>
                    <input type="number" name="Pressure" step="0.1" value="50" required>
                </div>
                <div class="form-group">
                    <label>Operation Speed (RPM)</label>
                    <input type="number" name="Speed" step="1" value="1500" required>
                </div>
                <div class="form-group">
                    <label>Vibration Level (mm/s)</label>
                    <input type="number" name="Vibration" step="0.1" value="5" required>
                </div>
                <div class="form-group">
                    <label>Ambient Humidity (%)</label>
                    <input type="number" name="Humidity" step="0.1" value="50" required>
                </div>
                <div class="form-group">
                    <label>Power Usage (kW)</label>
                    <input type="number" name="Power_Consumption" step="0.1" value="15" required>
                </div>
                <div class="form-group full-width">
                    <label>Work Material Hardness</label>
                    <input type="number" name="Material_Hardness" step="0.1" value="60" required>
                </div>
            </div>
            <button type="submit">
                <span>Run Health Analysis</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m5 12 7 7 7-7" />
                </svg>
            </button>
        </form>
    </div>
</div>