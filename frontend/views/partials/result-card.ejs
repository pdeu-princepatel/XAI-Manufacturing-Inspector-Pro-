<%
/*
  result-card.ejs
  prediction = { status, failure_probability, prediction,
    explanation: { features:[{name,key,raw_shap,impact,direction,reason}], recommendation },
    inputs: { Temperature, Pressure, Speed, Vibration, Humidity, Power_Consumption, Material_Hardness },
    model_confidence, top_risk_factor, risk_factors_count
  }
*/
const prob    = (prediction.failure_probability * 100);
const riskPct = prob.toFixed(1);
const isFail  = prediction.status === 'Fail';
const features = (prediction.explanation && prediction.explanation.features) || [];
const recText  = (prediction.explanation && prediction.explanation.recommendation) || '';
const inputs   = prediction.inputs || {};
const modelConfidence  = prediction.model_confidence  ?? 0;
const topRiskFactor    = prediction.top_risk_factor   || 'N/A';
const riskFactorsCount = prediction.risk_factors_count ?? 0;
const machineId        = prediction.machine_id || 'Unknown Machine';
const weaknesses       = prediction.weaknesses || [];
const improvementPlan  = prediction.improvement_plan || [];
const detailedSummary  = prediction.detailed_summary || { problem: '', cause: '', solution: '' };

const probColor = isFail ? 'var(--danger)' : 'var(--good)';
const causeColor = isFail ? 'var(--amber)' : 'var(--good)';

/* Signal-light logic */
const thresholds = {
  Temperature:       { caution: 75, alert: 90 },
  Pressure:          { caution: 90, alert: 120 },
  Speed:             { caution: 2000, alert: 2600 },
  Vibration:         { caution: 4,  alert: 7 },
  Humidity:          { caution: 70, alert: 85 },
  Power_Consumption: { caution: 150, alert: 220 },
  Material_Hardness: { caution: 75, alert: 90 },
};
function signalState(key, val) {
  const t = thresholds[key] || {};
  if (val >= (t.alert   || Infinity)) return 'alert';
  if (val >= (t.caution || Infinity)) return 'caution';
  return 'ok';
}
const signalLabel = s => s === 'alert' ? 'High' : s === 'caution' ? 'Watch' : 'Normal';

const friendlyName = {
  Temperature: 'Temperature', Pressure: 'Pressure', Speed: 'Speed',
  Vibration: 'Vibration', Humidity: 'Humidity',
  Power_Consumption: 'Power Usage', Material_Hardness: 'Hardness',
};
const sensorUnit = {
  Temperature: '°C', Pressure: ' PSI', Speed: ' RPM',
  Vibration: ' mm/s', Humidity: '%', Power_Consumption: ' kW', Material_Hardness: '',
};

function dirCls(d) {
  return d === 'negative' ? 'risk-up' : d === 'positive' ? 'risk-down' : 'risk-neutral';
}
%>

<%# ── Embed all chart data as a typed JSON script — no HTML-attribute encoding issues ── %>
<script id="chart-data" type="application/json">
{
  "riskPct":          <%- riskPct %>,
  "features":         <%- JSON.stringify(features) %>,
  "inputs":           <%- JSON.stringify(inputs) %>,
  "modelConfidence":  <%- modelConfidence %>,
  "topRiskFactor":    <%- JSON.stringify(topRiskFactor) %>,
  "riskFactorsCount": <%- riskFactorsCount %>,
  "isFail":           <%- isFail %>
}
</script>

<div class="result-layout">

  <%# ── Status badge ─────────────────────────────────────── %>
  <div class="status-badge <%= isFail ? 'needs-attention' : 'healthy' %>">
    <% if (isFail) { %>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
        <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
      </svg>
      Maintenance Recommended
    <% } else { %>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      All Systems Healthy
    <% } %>
  </div>

  <%# ══════════════════════════════════════════════════════════ %>
  <%# ── POWER BI: Executive Summary Banner ────────────────── %>
  <%# ══════════════════════════════════════════════════════════ %>
  <div class="exec-summary <%= isFail ? 'exec-fail' : 'exec-pass' %>">
    <div class="exec-summary-icon">
      <% if (isFail) { %>
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
          <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
      <% } else { %>
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
          <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
      <% } %>
    </div>
    <div class="exec-summary-body">
      <div class="exec-summary-title">
        <%= isFail ? 'Equipment Failure Risk Detected' : 'Equipment Operating Normally' %>
        <span style="font-size: 0.85rem; font-weight: normal; margin-left: 0.5rem; color: var(--text-dim);">Machine: <%= machineId %></span>
      </div>
      <div class="exec-summary-desc">
        <% if (isFail) { %>
          AI analysis flagged <strong><%= riskFactorsCount %> sensor <%= riskFactorsCount === 1 ? 'reading' : 'readings' %></strong>
          outside safe thresholds. The primary driver is <strong><%= topRiskFactor %></strong>.
          Immediate inspection recommended to prevent unplanned downtime.
        <% } else { %>
          All <%= Object.keys(inputs).length %> sensor readings are within healthy operating parameters.
          Model confidence is <strong><%= modelConfidence %>%</strong>.
          Next scheduled maintenance can proceed as planned.
        <% } %>
      </div>
    </div>
    <div class="exec-summary-score">
      <div class="exec-score-num <%= isFail ? 'text-danger' : 'text-success' %>"><%= riskPct %>%</div>
      <div class="exec-score-lbl">Failure Risk</div>
    </div>
  </div>

  <%# ══════════════════════════════════════════════════════════ %>
  <%# ── POWER BI: KPI Cards Row ────────────────────────────── %>
  <%# ══════════════════════════════════════════════════════════ %>
  <div class="kpi-row">

    <div class="kpi-card kpi-risk">
      <div class="kpi-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
          <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
      </div>
      <div class="kpi-body">
        <div class="kpi-label">Failure Risk</div>
        <div class="kpi-value" id="kpi-risk-value"><%= riskPct %>%</div>
        <div class="kpi-trend <%= isFail ? 'kpi-trend-bad' : 'kpi-trend-good' %>">
          <%= isFail ? '▲ Above threshold' : '▼ Within safe range' %>
        </div>
      </div>
    </div>

    <div class="kpi-card kpi-confidence">
      <div class="kpi-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
        </svg>
      </div>
      <div class="kpi-body">
        <div class="kpi-label">Model Confidence</div>
        <div class="kpi-value" id="kpi-confidence-value"><%= modelConfidence %>%</div>
        <div class="kpi-trend kpi-trend-neutral">XGBoost + SHAP</div>
      </div>
    </div>

    <div class="kpi-card kpi-top-factor">
      <div class="kpi-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/>
          <line x1="6" y1="20" x2="6" y2="14"/>
        </svg>
      </div>
      <div class="kpi-body">
        <div class="kpi-label">Top Risk Factor</div>
        <div class="kpi-value kpi-value-sm" id="kpi-topfactor-value"><%= topRiskFactor %></div>
        <div class="kpi-trend kpi-trend-neutral">Highest SHAP impact</div>
      </div>
    </div>

    <div class="kpi-card kpi-alerts">
      <div class="kpi-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
        </svg>
      </div>
      <div class="kpi-body">
        <div class="kpi-label">Risk Factors Active</div>
        <div class="kpi-value <%= riskFactorsCount > 0 ? 'text-danger' : 'text-success' %>" id="kpi-alerts-value">
          <%= riskFactorsCount %> / <%= features.length %>
        </div>
        <div class="kpi-trend <%= riskFactorsCount > 0 ? 'kpi-trend-bad' : 'kpi-trend-good' %>">
          <%= riskFactorsCount > 0 ? 'Sensors raising risk' : 'All sensors nominal' %>
        </div>
      </div>
    </div>

  </div>

  <%# ══════════════════════════════════════════════════════════ %>
  <%# ── Detailed Diagnostic Summary ── %>
  <%# ══════════════════════════════════════════════════════════ %>
  <div class="glowing-card-shell" style="margin-bottom: 2rem;">
    <div class="card-body" style="padding: 1.5rem 2rem;">
      <h3 style="font-size: 1.05rem; font-weight: 800; color: var(--text-bright); margin-bottom: 1rem; border-bottom: 1px solid var(--border-faint); padding-bottom: 0.5rem;">
        Detailed Diagnostic Summary for <%= machineId %>
      </h3>
      
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div style="background: rgba(255, 255, 255, 0.02); padding: 1rem; border-left: 3px solid <%= probColor %>; border-radius: 4px;">
          <h4 style="font-size: 0.85rem; color: <%= probColor %>; text-transform: uppercase; margin-bottom: 0.5rem; letter-spacing: 0.05em;">1. The Problem</h4>
          <p style="margin: 0; font-size: 0.95rem; color: var(--text-body); line-height: 1.5;"><%= detailedSummary.problem %></p>
        </div>
        
        <div style="background: rgba(255, 255, 255, 0.02); padding: 1rem; border-left: 3px solid <%= causeColor %>; border-radius: 4px;">
          <h4 style="font-size: 0.85rem; color: <%= causeColor %>; text-transform: uppercase; margin-bottom: 0.5rem; letter-spacing: 0.05em;">2. The Root Cause</h4>
          <p style="margin: 0; font-size: 0.95rem; color: var(--text-body); line-height: 1.5;"><%= detailedSummary.cause %></p>
        </div>
        
        <div style="background: rgba(255, 255, 255, 0.02); padding: 1rem; border-left: 3px solid var(--good); border-radius: 4px;">
          <h4 style="font-size: 0.85rem; color: var(--good); text-transform: uppercase; margin-bottom: 0.5rem; letter-spacing: 0.05em;">3. The Solution</h4>
          <p style="margin: 0; font-size: 0.95rem; color: var(--text-body); line-height: 1.5;"><%= detailedSummary.solution %></p>
        </div>
      </div>
    </div>
  </div>

  <%# ── Hero Score + Gauge ────────────────────────────────── %>
  <div class="glowing-card-shell">
    <div class="card-body">
      <div class="score-hero">
        <div class="score-text-block">
          <div class="score-unit-label">Failure Risk Score</div>
          <div class="score-number"><%= riskPct %>%</div>
          <p class="score-caption">
            <% if (isFail) { %>
              Our AI detected signs of stress in your equipment. A physical inspection soon will help prevent unexpected downtime.
            <% } else { %>
              Everything looks good — the machine is running comfortably within healthy operating limits.
            <% } %>
          </p>
        </div>
        <div class="gauge-wrapper">
          <canvas id="risk-gauge-chart"></canvas>
          <div class="gauge-center-label">Risk Level</div>
        </div>
      </div>
    </div>
  </div>

  <%# ── Sensor Signal Lights ───────────────────────────────── %>
  <% const inputKeys = Object.keys(inputs); %>
  <% if (inputKeys.length > 0) { %>
  <div class="section-title" style="margin-top:2rem;">
    <div class="title-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
           stroke="#f7ba2b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
    </div>
    Live Sensor Status
  </div>
  <div class="sensor-signals-grid">
    <% inputKeys.forEach(function(key) { %>
      <% const val = inputs[key]; %>
      <% const state = signalState(key, val); %>
      <div class="signal-card">
        <div class="signal-dot <%= state %>"></div>
        <div class="signal-info">
          <div class="signal-name"><%= friendlyName[key] || key %></div>
          <div class="signal-value"><%= parseFloat(val).toFixed(1) %><%= sensorUnit[key] || '' %></div>
        </div>
        <span class="signal-status-label <%= state %>"><%= signalLabel(state) %></span>
      </div>
    <% }); %>
  </div>
  <% } %>

  <%# ══════════════════════════════════════════════════════════ %>
  <%# ── POWER BI: Charts Grid (inc. Waterfall) ─────────────── %>
  <%# ══════════════════════════════════════════════════════════ %>
  <% if (features.length > 0) { %>
  <div class="section-title" style="margin-top:2rem;">
    <div class="title-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
           stroke="#f7ba2b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/>
        <line x1="6" y1="20" x2="6" y2="14"/>
      </svg>
    </div>
    Visual Breakdown
  </div>

  <div class="charts-grid">

    <div class="chart-panel">
      <div class="chart-panel-title">What Drove This Decision</div>
      <div class="chart-panel-subtitle">How strongly each factor pushed the AI's verdict — longer bar, bigger influence.</div>
      <div class="chart-canvas-box">
        <canvas id="feature-impact-chart"></canvas>
      </div>
    </div>

    <div class="chart-panel">
      <div class="chart-panel-title">Risk Share by Factor</div>
      <div class="chart-panel-subtitle">Each segment shows how large a role that sensor played in the total risk assessment.</div>
      <div class="chart-canvas-box">
        <canvas id="risk-breakdown-chart"></canvas>
      </div>
    </div>

    <div class="chart-panel wide">
      <div class="chart-panel-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="#f7ba2b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
             style="margin-right:6px;vertical-align:-2px">
          <rect x="2" y="3" width="4" height="18"/><rect x="10" y="8" width="4" height="13"/>
          <rect x="18" y="5" width="4" height="16"/>
        </svg>
        SHAP Contribution Waterfall
      </div>
      <div class="chart-panel-subtitle">How each factor's SHAP value cumulatively builds up to the final failure risk score. Modelled after Power BI waterfall charts.</div>
      <div class="chart-canvas-box tall">
        <canvas id="waterfall-chart"></canvas>
      </div>
    </div>

    <% if (inputKeys.length > 0) { %>
    <div class="chart-panel wide">
      <div class="chart-panel-title">Sensor Health Radar</div>
      <div class="chart-panel-subtitle">Each axis shows a reading normalised to its safe working range. Readings pushed outward indicate stress zones.</div>
      <div class="chart-canvas-box tall">
        <canvas id="sensor-radar-chart"></canvas>
      </div>
    </div>
    <% } %>

  </div>
  <% } %>

  <%# ══════════════════════════════════════════════════════════ %>
  <%# ── TABULAR: Interactive SHAP Data Table ───────────────── %>
  <%# ══════════════════════════════════════════════════════════ %>
  <div class="section-title" style="margin-top:2rem;">
    <div class="title-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
           stroke="#f7ba2b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/>
      </svg>
    </div>
    Why the AI said this &nbsp;<span class="table-badge">Interactive Table</span>
  </div>

  <% if (features.length > 0) { %>
  <div class="tableau-wrapper">
    <div class="tableau-controls">
      <div class="tableau-search-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="#71717a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input type="text" id="table-search" class="tableau-search" placeholder="Filter factors…" autocomplete="off">
      </div>
      <button id="export-csv-btn" class="export-csv-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Export CSV
      </button>
    </div>

    <div class="tableau-scroll">
      <table class="tableau-table" id="shap-table">
        <thead>
          <tr>
            <th class="sortable" data-col="0" data-type="string">
              Factor <span class="sort-icon">⇅</span>
            </th>
            <th class="sortable" data-col="1" data-type="number">
              Sensor Reading <span class="sort-icon">⇅</span>
            </th>
            <th class="sortable" data-col="2" data-type="number">
              SHAP Value <span class="sort-icon">⇅</span>
            </th>
            <th class="sortable" data-col="3" data-type="number">
              Influence % <span class="sort-icon">⇅</span>
            </th>
            <th class="sortable" data-col="4" data-type="string">
              Direction <span class="sort-icon">⇅</span>
            </th>
            <th>Insight</th>
          </tr>
        </thead>
        <tbody>
          <% features.forEach(function(f) { %>
            <%
              const rawVal   = inputs[f.key] !== undefined ? inputs[f.key] : '';
              const unit     = sensorUnit[f.key] || '';
              const cls      = dirCls(f.direction);
              const shapSign = (f.raw_shap || 0) > 0 ? '+' : '';
              const dirLabel = f.direction === 'negative' ? 'Raises Risk'
                             : f.direction === 'positive' ? 'Lowers Risk'
                             : 'Neutral';
            %>
            <tr class="shap-tr <%= cls %>-row" data-direction="<%= f.direction %>">
              <td class="td-factor">
                <div class="td-factor-name"><%= f.name %></div>
              </td>
              <td class="td-reading">
                <% if (rawVal !== '') { %>
                  <span class="reading-pill <%= signalState(f.key, rawVal) %>">
                    <%= parseFloat(rawVal).toFixed(1) %><%= unit %>
                  </span>
                <% } else { %>—<% } %>
              </td>
              <td class="td-shap <%= cls %>"><%= shapSign %><%= (f.raw_shap || 0).toFixed(4) %></td>
              <td class="td-pct">
                <div class="td-pct-row">
                  <div class="mini-bar-track">
                    <div class="mini-bar-fill <%= cls %>" style="width: <%= Math.min(f.impact, 100) %>%;"></div>
                  </div>
                  <span class="mini-pct-label"><%= f.impact.toFixed(1) %>%</span>
                </div>
              </td>
              <td>
                <span class="dir-badge <%= cls %>">
                  <% if (f.direction === 'negative') { %>▲<% } else if (f.direction === 'positive') { %>▼<% } else { %>—<% } %>
                  <%= dirLabel %>
                </span>
              </td>
              <td class="td-insight"><%= f.reason || '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (recText) { %>
    <div class="recommendation-box">
      <div class="recommendation-icon"><%= isFail ? '⚠️' : '✅' %></div>
      <div class="recommendation-text"><%= recText %></div>
    </div>
    <% } %>
  </div>

  <% } else { %>
  <div class="reasoning-block" style="margin-top:0;">
    <div class="reasoning-block-tag">Summary</div>
    <p style="color:var(--text-body);line-height:1.65;padding-top:0.5rem;">
      <% if (isFail) { %>
        Sensor readings outside normal ranges were detected. Schedule an inspection to catch any developing issues before they escalate.
      <% } else { %>
        All readings are within healthy ranges. Keep monitoring regularly and run the next check after your standard maintenance window.
      <% } %>
    </p>
  </div>
  <% } %>

  <%# ══════════════════════════════════════════════════════════ %>
  <%# ── DEEP DIVE ANALYTICS (Python DS & D3.js Custom Visuals) ── %>
  <%# ══════════════════════════════════════════════════════════ %>
  <div class="section-title" style="margin-top:2rem;">
    <div class="title-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
           stroke="#f7ba2b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/>
        <line x1="6" y1="20" x2="6" y2="14"/>
      </svg>
    </div>
    Deep Dive Analytics (Python & Custom JS Visuals)
  </div>

  <div class="charts-grid" style="grid-template-columns: 1fr;">
    <div class="chart-panel wide">
      <div class="chart-header">
        <h3 class="chart-title">Dataset Historical Distributions (Powered by Matplotlib & Seaborn)</h3>
      </div>
      <div id="python-analytics-container" style="text-align: center; color: var(--text-dim); padding: 2rem;">
        Generating historical analytics... <span class="spinner"></span>
      </div>
    </div>
  </div>

  <div class="charts-grid" style="grid-template-columns: 1fr;">
